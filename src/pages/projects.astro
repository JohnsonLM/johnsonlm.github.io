---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Icon } from "astro-icon/components";
import INFO from "../data/user";
import pages from "../data/pages";
---

<BaseLayout activeNav="projects" {...pages.projects}>
	<div class="page-content">
		<div class="content-wrapper">
			<div class="flex flex-col h-full m-0 pt-[120px] sm:pt-[60px]">
				<div class="title projects-title">What I'm working on.</div>
				<div class="subtitle projects-subtitle">
					I pride myself on developing and releasing new projects and resources for the online community.
					These are the projects I've had the pleasure to build, work on, and contribute to.
				</div>
				<div class="projects-list">
					<div class="grid grid-cols-3 gap-4 items-stretch py-[30px] lg:grid-cols-2 md:grid-cols-1">
						{
							INFO.projects.map((project) => (
								<div class="box-border overflow-hidden">
									<div class="mix-blend-normal rounded-lg opacity-100 h-full bg-[var(--color-card)] border border-[var(--color-border)] hover:bg-[var(--color-hover-bg)] hover:opacity-100 transition-colors duration-300 [&:hover_.project-link]:text-[var(--color-link)] [&:hover_.project-link]:transition-colors [&:hover_.project-link]:duration-300 sm:h-full">
										<a href={project.link} class="no-underline">
											<div class="flex flex-col min-h-[210px] p-6">
												<div class="w-[30px]">
													<img src={project.logo.replace(/^\.\//, "/")} alt="" class="w-full" />
												</div>
												<div class="font-secondary text-[var(--color-primary)] text-base pt-[15px] mb-[1em] font-bold">{project.title}</div>
												<div class="text-[var(--color-secondary)] leading-relaxed">{project.description}</div>
												<div class="project-link flex items-center gap-[10px] text-[var(--color-secondary)] text-xs pt-5 mt-auto">
													<Icon class="w-[14px] h-[14px] flex-none" name="lucide:link" aria-hidden="true" />
													<div class="font-bold">{project.linkText}</div>
												</div>
											</div>
										</a>
									</div>
								</div>
							))
						}
					</div>
				</div>
			</div>
					</div>
	</div>
</BaseLayout>
