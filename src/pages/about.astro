---
import { Icon } from "astro-icon/components";
import BaseLayout from "../layouts/BaseLayout.astro";
import site from "../data/site";
import pages from "../data/pages";
import socials from "../data/socials";
---

<BaseLayout activeNav="about" {...pages.about} image="/about.webp">
	<main class="content-page px-5 pt-26 sm:px-8">
		<div class="page-container">
			<div class="grid gap-12 lg:grid-cols-2 lg:items-center">
				<div class="max-w-96 rotate-2 overflow-hidden rounded-lg transition-transform duration-300 hover:rotate-0">
					<img src="/about.webp" alt="about" class="block w-full" />
				</div>
				<div>
					<h1 class="page-title text-[clamp(38px,5vw,52px)]">{site.about.title}</h1>
					<p class="page-description mt-6 max-w-145">{site.about.description}</p>
				</div>
			</div>
			<div class="pt-8 flex flex-col gap-5">
				{socials.map((link) => <a href={link.href} target="_blank" rel="noreferrer" class="group inline-flex items-center gap-3.5 text-sm font-semibold text-secondary no-underline hover:text-link"><Icon class="box-border size-6.5 rounded-full border border-border p-1.25 text-secondary group-hover:border-link group-hover:text-link" name={link.icon} aria-hidden="true" /><span>{link.label}</span></a>)}
				<a href={`mailto:${site.main.email}`} class="group inline-flex items-center gap-3.5 text-sm font-semibold text-secondary underline hover:text-link"><Icon class="box-border size-6.5 rounded-full border border-border p-1.25 text-secondary group-hover:border-link group-hover:text-link" name="lucide:mail" aria-hidden="true" /><span>{site.main.email}</span></a>
			</div>
		</div>
	</main>
</BaseLayout>
