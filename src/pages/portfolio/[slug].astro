---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
	const portfolio = await getCollection("portfolio");
	return portfolio.map((item) => ({
		params: { slug: item.id.split("/")[0] },
		props: { item },
	}));
}

const { item } = Astro.props;
const itemPath = `/portfolio/${item.id.split("/")[0]}`;
const sourceLabel = item.data.link.includes("artstation")
	? "View on ArtStation"
	: item.data.link.includes("sketchfab")
		? "View on Sketchfab"
		: "View the original project";
const { images, videos, sketchfabIds } = item.data;
---

<BaseLayout
	title={item.data.title}
	description={item.data.description}
	keywords={item.data.keywords}
	path={itemPath}
	image={item.data.background}
>
	<main class="detail-page sm:px-8 sm:pt-36">
		<article class="page-container">
			<a href="/portfolio" class="back-link mb-10">← <span>Back to portfolio</span></a>

			<header class="mb-12 max-w-190">
				<h1 class="m-0 font-secondary text-[clamp(40px,6vw,58px)] leading-none tracking-[-0.04em]">{item.data.title}</h1>
				<p class="mt-6 mb-0 max-w-170 font-serif text-lg leading-relaxed text-secondary">{item.data.description}</p>
				{item.data.link !== "#" && (
					<a href={item.data.link} target="_blank" rel="noreferrer" class="mt-6 inline-flex items-center gap-1.5 font-secondary text-sm font-bold text-link underline underline-offset-4">
						{sourceLabel} <Icon name="lucide:arrow-up-right" class="size-4" />
					</a>
				)}
			</header>

			{(images.length > 0 || videos.length > 0 || sketchfabIds.length > 0) && (
				<section aria-label="Project media" class="flex flex-col gap-5">
					{videos.map((video) => (
						<video class="max-h-[78vh] w-full border border-border bg-black object-contain" controls preload="metadata">
							<source src={video} type="video/mp4" />
						</video>
					))}
					{images[0] && (
						<figure class="m-0 overflow-hidden border border-border bg-card">
							<Image src={images[0]} alt={`${item.data.title} — image 1`} loading="eager" class="block h-auto w-full max-w-none" />
						</figure>
					)}
					{(images.length > 1 || sketchfabIds.length > 0) && (
						<div class="grid grid-cols-1 items-start gap-5 sm:grid-cols-2">
							{images.slice(1).map((image, index) => (
								<figure class="m-0 overflow-hidden border border-border bg-card">
									<Image src={image} alt={`${item.data.title} — image ${index + 2}`} loading="lazy" class="block h-auto w-full max-w-none" />
								</figure>
							))}
							{sketchfabIds.map((id) => (
								<div class="overflow-hidden border border-border bg-[#101014]">
									<iframe title={`Interactive 3D model: ${item.data.title}`} class="aspect-video w-full border-0" src={`https://sketchfab.com/models/${id}/embed?autostart=0&ui_theme=dark`} loading="lazy" allow="autoplay; fullscreen; xr-spatial-tracking" allowfullscreen />
								</div>
							))}
						</div>
					)}
				</section>
			)}
		</article>
	</main>
</BaseLayout>
