---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import BaseLayout from "../../layouts/BaseLayout.astro";
import pages from "../../data/pages";
import { getCollection } from "astro:content";
const portfolio = (await getCollection("portfolio")).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout activeNav="portfolio" {...pages.portfolio}>
	<div class="page-content">
		<div class="page-container">
			<div class="flex h-full flex-col px-5 pt-28 pb-20 sm:px-8 sm:pt-36">
				<header class="mb-12 max-w-175">
					<p class="section-kicker">Selected work</p>
					<h1 class="section-title">Portfolio</h1>
					<p class="mt-5 max-w-150 font-serif text-lg leading-relaxed text-secondary">A collection of 3D art, scientific visualization, design, and digital experiments.</p>
				</header>
				<div>
					{portfolio.map((item, index) => {
						const iconName = { "3D": "lucide:cuboid", Design: "lucide:pen-tool", Web: "lucide:globe" }[item.data.type];
						const reversed = index % 2 === 1;
						const slug = item.id.split("/")[0];
						return (
							<a href={`/portfolio/${slug}`} class="group grid grid-cols-1 gap-5 border-t border-border py-6 no-underline motion-safe:animate-[cardrotationin_1s_forwards] motion-safe:hover:animate-[cardrotationout_1s_forwards] md:grid-cols-12 md:items-center md:gap-8">
								<div class:list={["overflow-hidden bg-card md:col-span-8", reversed && "md:order-2"]}>
									<Image src={item.data.background} alt={item.data.title} loading={index < 4 ? "eager" : "lazy"} class="block aspect-video size-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.03]" />
								</div>
								<div class:list={["md:col-span-4", reversed && "md:order-1"]}>
									<div class="mb-3 flex justify-end text-tertiary">
										<Icon class="size-4" name={iconName} aria-hidden="true" />
									</div>
									<h2 class="m-0 max-w-100 font-secondary text-[clamp(25px,3vw,40px)] leading-[1.05] tracking-[-0.03em] text-primary transition-colors group-hover:text-link">{item.data.title}</h2>
									<p class="mt-4 mb-0 text-sm leading-6 text-secondary">{item.data.subtitle}</p>
									<span class="mt-5 inline-flex items-center gap-2 font-secondary text-xs font-bold uppercase tracking-[0.12em] text-link">View project <Icon name="lucide:arrow-up-right" class="size-4 transition-transform duration-200 group-hover:translate-x-1 group-hover:-translate-y-1" /></span>
								</div>
							</a>
						);
					})}
				</div>
			</div>
		</div>
	</div>
</BaseLayout>

