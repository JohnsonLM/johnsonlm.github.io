---
import BaseLayout from "../../layouts/BaseLayout.astro";
import NavBar from "../../components/common/NavBar.astro";
import Footer from "../../components/common/Footer.astro";
import Logo from "../../components/common/Logo.astro";
import { Icon } from "astro-icon/components";
import pages from "../../data/pages";
import { getCollection } from "astro:content";
import "../styles/portfolio.css";

const portfolio = (await getCollection("portfolio")).sort((a, b) => a.data.order - b.data.order);
type PortfolioType = "3D" | "Design" | "Web";
const iconFor = (type: PortfolioType) => {
	if (type === "3D") return "lucide:cuboid";
	if (type === "Design") return "lucide:pen-tool";
	return "lucide:globe";
};
---

<BaseLayout {...pages.portfolio}>
	<div class="page-content">
		<NavBar active="portfolio" />
		<div class="content-wrapper">
			<div class="about-logo-container">
				<div class="about-logo"><Logo width={46} /></div>
			</div>
			<div class="portfolio-container">
				<div class="portfolio-title">Portfolio</div>
				<div class="portfolio-items">
					{
						portfolio.map((item) => (
							<a href={`/portfolio/${item.id}`} class="portfolio-link">
								<div class="portfolio-item" style={`background-image: url(${item.data.background})`}>
									<div class="portfolio-item-title">
										<Icon class="portfolio-type-icon" name={iconFor(item.data.type)} aria-hidden="true" />
										{item.data.title}
									</div>
									<div class="portfolio-item-subtitle">{item.data.subtitle}</div>
								</div>
							</a>
						))
					}
				</div>
			</div>
			<div class="page-footer"><Footer /></div>
		</div>
	</div>
</BaseLayout>
