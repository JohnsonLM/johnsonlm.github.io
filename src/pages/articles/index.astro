---
import BaseLayout from "../../layouts/BaseLayout.astro";
import site from "../../data/site";
import pages from "../../data/pages";
import { Icon } from "astro-icon/components";
import { getCollection } from "astro:content";

const articles = (await getCollection("articles")).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout activeNav="articles" {...pages.articles}>
	<main class="article-page">
		<article class="page-container">
			<header class="mb-10 max-w-160">
				<h1 class="section-title">{site.articles.title}</h1>
				<p class="mt-5 mb-0 font-serif text-lg leading-relaxed text-secondary max-[760px]:text-base">{site.articles.description}</p>
			</header>

			<div>
				{articles.map((article) => <a href={`/articles/${article.id}`} class="group block border-t border-border py-7 text-inherit no-underline last:border-b max-[760px]:py-6"><div class="mb-2 flex items-center justify-between gap-6 font-mono text-[10px] uppercase tracking-[0.12em] text-secondary"><time>{article.data.date}</time></div><div class="flex items-start justify-between gap-6"><div><h2 class="m-0 font-secondary text-lg leading-tight tracking-[-0.025em] transition-colors group-hover:text-link">{article.data.title}</h2><p class="mt-3 mb-0 max-w-145 font-serif text-base leading-relaxed text-secondary">{article.data.description}</p></div><Icon name="lucide:arrow-up-right" class="mt-1 size-4 flex-none text-secondary transition-transform group-hover:translate-x-1 group-hover:-translate-y-1 group-hover:text-link" /></div></a>)}
			</div>
		</article>
	</main>
</BaseLayout>
