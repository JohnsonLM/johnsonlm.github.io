---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import PointCloudBackground from "../components/PointCloudBackground.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import site from "../data/site";
import projects from "../data/projects";
import pages from "../data/pages";
import { getCollection } from "astro:content";
import socials from "../data/socials";

const articles = (await getCollection("articles")).sort((a, b) => a.data.order - b.data.order);
const portfolio = (await getCollection("portfolio")).sort((a, b) => a.data.order - b.data.order);
const featuredWork = portfolio.slice(0, 3);
const compactSocials = socials.filter((link) => link.compactLabel);

---

<BaseLayout activeNav="home" {...pages.home}>
	<main class="overflow-hidden bg-secondary-bg text-primary">
		<section class="relative min-h-155 bg-[#101312] text-white">
			<PointCloudBackground />
			<div class="relative z-2 box-border flex min-h-155 w-[90%] max-w-250 mx-auto flex-col justify-end pt-30 pb-15 max-[760px]:min-h-155 max-[760px]:pt-28 max-[760px]:pb-12">
				<div class="hero-identity mb-6 flex items-center gap-3.5">
					<img src={site.main.logo} alt="" class="size-14.5 rounded-full border border-white/50 object-cover" />
					<strong class="font-secondary text-base">{site.main.name}</strong>
				</div>
				<div class="max-w-172.5">
					<h1 class="m-0 font-secondary text-[clamp(46px,6vw,68px)] leading-none tracking-[-0.035em] max-[760px]:text-[44px]">
						{site.homepage.title}
					</h1>
					<p class="my-4.5 max-w-162.5 text-base leading-[1.58] text-[#d6e7e2] max-[760px]:text-[15px] max-[760px]:leading-[1.55]">
						{site.homepage.description}
					</p>
					<div class="flex items-center gap-4" aria-label="Social links">
						{compactSocials.map((link) => <a href={link.href} target="_blank" rel="noreferrer" aria-label={link.compactLabel} class="social-link"><Icon name={link.compactIcon ?? link.icon} class="size-4 fill-current" /></a>)}
						<a href={`mailto:${site.main.email}`} aria-label="Email" class="social-link"><Icon name="lucide:mail" class="size-4" /></a>
					</div>
				</div>
			</div>
		</section>

		<div class="w-[90%] max-w-250 mx-auto">
			<section class="py-8 max-[760px]:py-14">
				<header class="section-header">
					<div><p class="section-kicker">What I’m building</p><h2 class="section-title">Projects</h2></div>
				</header>
				<div class="grid grid-cols-3 gap-3.5 max-[900px]:grid-cols-2 max-[760px]:grid-cols-1">
					{projects.map((project, index) => (
						<a href={project.link} class:list={["tilt-card flex min-h-40 flex-col rounded-lg border border-border bg-card p-6 text-inherit no-underline", index % 2 ? "tilt-left" : "tilt-right"]}>
							<img src={project.logo.replace(/^\.\//, "/")} alt="" class="size-7.5 object-contain" />
							<h3 class="mt-5.5 mb-2.5 font-secondary text-[17px]">{project.title}</h3>
							<p class="m-0 text-sm leading-relaxed text-secondary">{project.description}</p>
							<small class="mt-auto pt-5 font-bold text-secondary">{project.linkText} ↗</small>
						</a>
					))}
				</div>
			</section>

			<section class="py-8 max-[760px]:py-14">
				<header class="section-header">
					<div><p class="section-kicker">Things I’ve made</p><h2 class="section-title">Portfolio</h2></div>
					<a href="/portfolio" class="section-link">View everything <span aria-hidden="true">→</span></a>
				</header>
				<div class="grid grid-cols-[1.5fr_0.75fr] grid-rows-2 gap-6 max-[760px]:grid-cols-1 max-[760px]:grid-rows-none">
					{featuredWork.map((item, index) => {
						const iconName = { "3D": "lucide:cuboid", Design: "lucide:pen-tool", Web: "lucide:globe" }[item.data.type];
						const slug = item.id.split("/")[0];
						return <a href={`/portfolio/${slug}`} class:list={["group text-inherit no-underline", index === 0 ? "row-span-2 max-[760px]:row-auto" : "", index % 2 ? "tilt-left" : "tilt-right"]}>
							<div class:list={["relative overflow-hidden rounded-lg bg-[#222] max-[760px]:h-65", index === 0 ? "h-120" : "h-48"]}><Image src={item.data.background} alt="" loading="lazy" class="size-full object-cover transition-transform duration-500 group-hover:scale-[1.025]" /><span class="absolute top-3.5 left-3.5 flex items-center gap-1.5 rounded-full bg-black/70 px-2.5 py-2 font-secondary text-[10px] font-bold text-white backdrop-blur-lg"><Icon name={iconName} />{item.data.type}</span></div>
							<div class="px-0.5 py-4"><h3 class:list={["m-0 mb-1 font-secondary", index === 0 ? "text-2xl" : "text-lg"]}>{item.data.title}</h3><p class="m-0 text-[13px] text-secondary">{item.data.subtitle}</p></div>
						</a>;
					})}
				</div>
			</section>

			<section class="py-8 max-[760px]:py-14">
				<header class="section-header">
					<div><p class="section-kicker">Notes &amp; rabbit trails</p><h2 class="section-title">Articles</h2></div>
					<a href="/articles" class="section-link">View all <span aria-hidden="true">→</span></a>
				</header>
				<div>
					{articles.map((article) => <a href={`/articles/${article.id}`} class="group block border-t border-border py-7 text-inherit no-underline last:border-b max-[760px]:py-6"><div class="mb-2 flex items-center justify-between gap-6 font-mono text-[10px] uppercase tracking-[0.12em] text-secondary"><time>{article.data.date}</time></div><div class="flex items-start justify-between gap-6"><div><h3 class="m-0 font-secondary text-lg leading-tight tracking-[-0.025em] transition-colors group-hover:text-link">{article.data.title}</h3><p class="mt-3 mb-0 max-w-145 font-serif text-base leading-relaxed text-secondary">{article.data.description}</p></div><Icon name="lucide:arrow-up-right" class="mt-1 size-4 flex-none text-secondary transition-transform group-hover:translate-x-1 group-hover:-translate-y-1 group-hover:text-link" /></div></a>)}
				</div>
			</section>

		</div>
	</main>
</BaseLayout>
