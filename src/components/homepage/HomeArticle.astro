---
import { Icon } from "astro-icon/components";
import "./styles/article.css";

const { title, description, date, href, index } = Astro.props;
---

<a href={href}>
	<div class="homepage-article-card">
		<div class="homepage-article-index">{String(index).padStart(2, "0")}</div>
		<div class="homepage-article-copy">
			<div class="homepage-article-date">{date}</div>
			<div class="homepage-article-title">{title}</div>
			<div class="homepage-article-description">{description}</div>
		</div>
		<div class="homepage-article-link" aria-hidden="true">
				<Icon name="lucide:chevron-right" />
		</div>
	</div>
</a>
