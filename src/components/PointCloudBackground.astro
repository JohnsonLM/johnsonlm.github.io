---
import { pointCloudConfig } from "./point-cloud/config";
---

<div
	data-point-cloud
	class="pointer-events-none absolute inset-x-0 top-0 z-0 [&[data-unsupported='true']]:hidden"
	style={`height: calc(100% + ${pointCloudConfig.bleedBelow}px)`}
>
	<canvas class="absolute inset-[-24px_0] h-[calc(100%+48px)] w-full translate-y-[100px] opacity-100 saturate-150 brightness-125" aria-hidden="true"></canvas>
</div>

<script>
	import { pointCloudConfig } from "./point-cloud/config";
	import { loadPointCloud } from "./point-cloud/plyLoader";
	import { PointCloudRenderer } from "./point-cloud/renderer";

	const background = document.querySelector<HTMLElement>("[data-point-cloud]");
	const canvas = background?.querySelector<HTMLCanvasElement>("canvas");

	if (background && canvas) {
		try {
			const renderer = new PointCloudRenderer(canvas, pointCloudConfig);
			const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
			let pointerX = 0;
			let pointerY = 0;
			let targetX = 0;
			let targetY = 0;
			let frameId = 0;
			let isIntersecting = true;
			let destroyed = false;

			const draw = () => renderer.draw(pointerX, pointerY);
			const animate = () => {
				frameId = 0;
				if (document.hidden || !isIntersecting || reducedMotion.matches || destroyed) return;
				pointerX += (targetX - pointerX) * pointCloudConfig.interaction.smoothing;
				pointerY += (targetY - pointerY) * pointCloudConfig.interaction.smoothing;
				draw();
				frameId = requestAnimationFrame(animate);
			};
			const schedule = () => {
				if (!frameId && !document.hidden && isIntersecting && !reducedMotion.matches && !destroyed) {
					frameId = requestAnimationFrame(animate);
				}
			};
			const onPointerMove = (event: PointerEvent) => {
				targetX = (event.clientX / window.innerWidth - 0.5) * 2;
				targetY = (event.clientY / window.innerHeight - 0.5) * -2;
			};
			const onVisibilityChange = () => {
				if (document.hidden) {
					if (frameId) cancelAnimationFrame(frameId);
					frameId = 0;
				} else {
					draw();
					schedule();
				}
			};
			const onContextLost = (event: Event) => {
				event.preventDefault();
				cleanup();
				background.dataset.unsupported = "true";
			};
			const resizeObserver = new ResizeObserver(draw);
			const intersectionObserver = new IntersectionObserver(([entry]) => {
				isIntersecting = entry?.isIntersecting ?? true;
				if (isIntersecting) {
					draw();
					schedule();
				} else if (frameId) {
					cancelAnimationFrame(frameId);
					frameId = 0;
				}
			});
			const cleanup = () => {
				if (destroyed) return;
				destroyed = true;
				if (frameId) cancelAnimationFrame(frameId);
				window.removeEventListener("pointermove", onPointerMove);
				document.removeEventListener("visibilitychange", onVisibilityChange);
				canvas.removeEventListener("webglcontextlost", onContextLost);
				resizeObserver.disconnect();
				intersectionObserver.disconnect();
				renderer.destroy();
			};

			window.addEventListener("pointermove", onPointerMove, { passive: true });
			document.addEventListener("visibilitychange", onVisibilityChange);
			canvas.addEventListener("webglcontextlost", onContextLost);
			document.addEventListener("astro:before-swap", cleanup, { once: true });
			resizeObserver.observe(canvas);
			intersectionObserver.observe(canvas);

			loadPointCloud(pointCloudConfig.assetUrl)
				.then((data) => {
					if (destroyed) return;
					renderer.upload(data);
					draw();
					schedule();
				})
				.catch((error: unknown) => {
					console.warn("Point cloud failed to load:", error);
					cleanup();
					background.dataset.unsupported = "true";
				});
			draw();
		} catch (error) {
			console.warn("Point cloud is unavailable:", error);
			background.dataset.unsupported = "true";
		}
	}
</script>
