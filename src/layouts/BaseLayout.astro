---
import "../app.css";
import { Icon } from "astro-icon/components";
import INFO from "../data/user";

const {
	title = INFO.main.title,
	description = "",
	keywords = [],
	path = Astro.url.pathname,
	image = "/avatar.jpeg",
	type = "website",
	noindex = false,
	jsonLd,
	activeNav = "",
} = Astro.props;

const pageTitle = title === INFO.main.title ? title : `${title} | ${INFO.main.title}`;
const site = Astro.site ?? new URL("https://johnsonlm.com");
const canonicalUrl = new URL(path, site).toString();
const imageUrl = new URL(image, site).toString();
const structuredData =
	jsonLd ??
	{
		"@context": "https://schema.org",
		"@type": type === "article" ? "Article" : "WebPage",
		name: pageTitle,
		headline: pageTitle,
		description,
		url: canonicalUrl,
		image: imageUrl,
		author: {
			"@type": "Person",
			name: INFO.main.name,
			url: site.toString(),
		},
	};

const navLinks = [
	["home", "/", "Home"],
	["about", "/about", "About"],
	["projects", "/projects", "Projects"],
	["portfolio", "/portfolio", "Portfolio"],
	["articles", "/articles", "Articles"]
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<link rel="canonical" href={canonicalUrl} />
		<title>{pageTitle}</title>
		{description && <meta name="description" content={description} />}
		{keywords.length > 0 && <meta name="keywords" content={keywords.join(", ")} />}
		{noindex && <meta name="robots" content="noindex" />}
		<meta property="og:site_name" content={INFO.main.title} />
		<meta property="og:type" content={type} />
		<meta property="og:title" content={pageTitle} />
		{description && <meta property="og:description" content={description} />}
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={imageUrl} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		{description && <meta name="twitter:description" content={description} />}
		<meta name="twitter:image" content={imageUrl} />
		<script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
		<script is:inline>
			const storedTheme = localStorage.getItem("theme") === "dark-theme" ? "dark-theme" : "light-theme";
			document.documentElement.classList.remove("light-theme", "dark-theme");
			document.documentElement.classList.add(storedTheme);
		</script>
	</head>
	<body>
		<header class="flex justify-center items-center m-0">
			<nav class="fixed top-[3vh] z-999 left-1/2 -translate-x-1/2 sm:top-3">
				<div class="w-auto min-h-[42px] px-4 bg-[var(--color-background)]/70 shadow-sm border border-[var(--color-border)]/80 rounded-full backdrop-blur-lg">
					<ul class="flex justify-center gap-[18px] list-none items-center m-0 py-[10px] sm:gap-[10px]">
						{
							navLinks.map(([key, href, label]) => (
								<li class={`font-bold text-[13px] leading-none whitespace-nowrap ${activeNav === key ? "[&>a]:text-[var(--color-link)]" : ""} sm:text-[12px]`}>
									<a href={href} class="no-underline text-primary hover:text-[var(--color-link)] transition-colors duration-300">{label}</a>
								</li>
							))
						}
						<li class="cursor-pointer font-bold">
							<button id="theme-toggle" type="button" aria-label="Toggle theme" class="grid place-items-center w-6 h-6 p-0 border-0 cursor-pointer bg-transparent">
								<Icon class="w-4 h-4 theme-icon-light" name="lucide:moon" aria-hidden="true" />
								<Icon class="w-4 h-4 theme-icon-dark hidden" name="lucide:sun" aria-hidden="true" />
							</button>
						</li>
					</ul>
				</div>
			</nav>
		</header>
		<style>
			:root.light-theme .theme-icon-dark { display: none; }
			:root.dark-theme .theme-icon-light { display: none; }
			.theme-icon-light svg,
			.theme-icon-light svg path,
			.theme-icon-light svg circle,
			.theme-icon-light svg g { stroke: #1c1c1e; fill: none !important; }
			:root.dark-theme .theme-icon-light svg,
			:root.dark-theme .theme-icon-light svg path,
			:root.dark-theme .theme-icon-light svg circle,
			:root.dark-theme .theme-icon-light svg g { stroke: #d5d5df; }
			.theme-icon-dark svg,
			.theme-icon-dark svg path,
			.theme-icon-dark svg circle,
			.theme-icon-dark svg g { stroke: #d5d5df; fill: none !important; }
			:root.light-theme .theme-icon-dark svg,
			:root.light-theme .theme-icon-dark svg path,
			:root.light-theme .theme-icon-dark svg circle,
			:root.light-theme .theme-icon-dark svg g { stroke: #1c1c1e; }
		</style>
		<slot />
		<footer class="page-footer">
			<div class="flex p-5 items-center">
				<div class="justify-end text-tertiary text-sm text-right sm:w-full sm:flex sm:justify-center">
					© 2026 Johnson Martin. All Rights Reserved.
				</div>
			</div>
		</footer>
		<script>
			const toggle = document.getElementById("theme-toggle");
			const applyTheme = (theme) => {
				document.documentElement.classList.remove("light-theme", "dark-theme");
				document.documentElement.classList.add(theme);
				localStorage.setItem("theme", theme);
			};
			toggle?.addEventListener("click", () => {
				const currentTheme = document.documentElement.classList.contains("dark-theme") ? "dark-theme" : "light-theme";
				applyTheme(currentTheme === "light-theme" ? "dark-theme" : "light-theme");
			});
		</script>
	</body>
</html>
