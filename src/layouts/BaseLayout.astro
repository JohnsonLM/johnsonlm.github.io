---
import "../app.css";
import { Icon } from "astro-icon/components";
import siteInfo from "../data/site";

const {
	title = siteInfo.main.name,
	description = "",
	keywords = [],
	path = Astro.url.pathname,
	image = "/avatar.jpeg",
	type = "website",
	noindex = false,
	jsonLd,
	activeNav = "",
} = Astro.props;

const pageTitle = title === siteInfo.main.name ? title : `${title} | ${siteInfo.main.name}`;
const site = Astro.site ?? new URL("https://johnsonlm.com");
const canonicalUrl = new URL(path, site).toString();
const imageUrl = new URL(image, site).toString();
const structuredData =
	jsonLd ??
	{
		"@context": "https://schema.org",
		"@type": type === "article" ? "Article" : "WebPage",
		name: pageTitle,
		headline: pageTitle,
		description,
		url: canonicalUrl,
		image: imageUrl,
		author: {
			"@type": "Person",
			name: siteInfo.main.name,
			url: site.toString(),
		},
	};

const navLinks = [
	["home", "/", "Home"],
	["about", "/about", "About"],
	["portfolio", "/portfolio", "Portfolio"],
	["articles", "/articles", "Articles"],
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<link rel="canonical" href={canonicalUrl} />
		<title>{pageTitle}</title>
		{description && <meta name="description" content={description} />}
		{keywords.length > 0 && <meta name="keywords" content={keywords.join(", ")} />}
		{noindex && <meta name="robots" content="noindex" />}
		<meta property="og:site_name" content={siteInfo.main.name} />
		<meta property="og:type" content={type} />
		<meta property="og:title" content={pageTitle} />
		{description && <meta property="og:description" content={description} />}
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={imageUrl} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		{description && <meta name="twitter:description" content={description} />}
		<meta name="twitter:image" content={imageUrl} />
		<script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
		<script is:inline>
			const storedTheme = localStorage.getItem("theme") === "dark-theme" ? "dark-theme" : "light-theme";
			document.documentElement.classList.remove("light-theme", "dark-theme");
			document.documentElement.classList.add(storedTheme);
		</script>
	</head>
	<body>
		<header class="flex items-center justify-center">
			<nav class="fixed top-[3vh] left-1/2 z-999 -translate-x-1/2 sm:top-3">
				<div id="nav-pill" class="nav-pill flex min-h-10 w-auto items-center rounded-full border border-border/80 bg-background/70 px-4 shadow-sm backdrop-blur-lg">
					{activeNav === "home" && (
						<a href="/" class="nav-profile" aria-label={`${siteInfo.main.name}, home`}>
							<img src={siteInfo.main.logo} alt="" />
							<span>{siteInfo.main.name}</span>
						</a>
					)}
					<ul class="m-0 flex list-none items-center justify-center gap-4 p-0">
						{
							navLinks.map(([key, href, label]) => (
								<li class="font-bold sm:text-xs">
									<a class:list={[key === "home" ? "grid size-6 place-items-center" : "inline-flex items-center", "text-primary no-underline transition-colors duration-300 hover:text-link", activeNav === key && "!text-link"]} href={href} aria-label={key === "home" ? label : undefined}>
										{key === "home" ? <Icon name="lucide:home" class="size-4" aria-hidden="true" /> : label}
									</a>
								</li>
							))
						}
						<li class="font-bold">
							<button id="theme-toggle" type="button" aria-label="Toggle color theme" class="theme-toggle grid size-6 cursor-pointer place-items-center border-0 bg-transparent p-0 text-primary">
								<Icon class="theme-icon-light size-4 text-primary" name="lucide:moon" aria-hidden="true" />
								<Icon class="theme-icon-dark size-4 text-primary" name="lucide:sun" aria-hidden="true" />
							</button>
						</li>
					</ul>
				</div>
			</nav>
		</header>
		<slot />
		<footer class="page-footer">
			<div class="flex items-center p-5">
				<div class="text-right text-sm text-tertiary sm:flex sm:w-full sm:justify-center">
					© {new Date().getFullYear()} Johnson Martin. All Rights Reserved.
				</div>
			</div>
		</footer>
		<script>
			const toggle = document.getElementById("theme-toggle");
			const navPill = document.getElementById("nav-pill");
			const applyTheme = (theme: "light-theme" | "dark-theme") => {
				document.documentElement.classList.remove("light-theme", "dark-theme");
				document.documentElement.classList.add(theme);
				localStorage.setItem("theme", theme);
			};
			toggle?.addEventListener("click", () => {
				const currentTheme = document.documentElement.classList.contains("dark-theme") ? "dark-theme" : "light-theme";
				applyTheme(currentTheme === "light-theme" ? "dark-theme" : "light-theme");
			});
			const updateNavPill = () => {
				navPill?.classList.toggle("is-scrolled", window.scrollY > 24);
				document.documentElement.classList.toggle("show-nav-profile", window.scrollY > 80);
			};
			window.addEventListener("scroll", updateNavPill, { passive: true });
			updateNavPill();
		</script>
	</body>
</html>
